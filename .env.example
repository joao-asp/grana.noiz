# ================================
# CONFIGURAÇÃO DO BOT DA CAIXINHA
# ================================
# 
# Copie este arquivo para .env na raiz do projeto
# e preencha com suas informações reais

# Token do Bot do Telegram (OBRIGATÓRIO)
# Obtenha com @BotFather: /newbot
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# Valor da Contribuição Mensal (em reais)
# Cota real da ITCP: R$ 5,00
VALOR_CONTRIBUICAO=5.0

# Configurações de Cobrança Automática
COBRANCA_DIA=10        # Dia do mês (1-31)
COBRANCA_HORA=9        # Hora do dia (0-23) 
COBRANCA_MINUTO=0      # Minuto da hora (0-59)

# IDs dos Administradores do Telegram
# Descubra seu ID com @userinfobot
# Formato: ADMINS=123456789,987654321
ADMINS=

# Configurações Avançadas
DB_PATH=data/caixinha.db
# Diretório dos CSVs de carga legada
LEGADO_DIR=data/legado
TIMEZONE=America/Sao_Paulo
ENV=production
DEBUG=false

# ================================
# INTERFACE WEB
# ================================
# Painel mobile-first servido por "python -m src.web"
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_PUBLIC_URL=http://localhost:8080

# Login do painel oculto /admin
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=troque-esta-senha
# Opcional e recomendado em produção: hash PBKDF2 no lugar da senha em texto
WEB_ADMIN_PASSWORD_HASH=
WEB_SESSION_TTL_HOURS=12
# true quando a web estiver atrás de HTTPS
WEB_COOKIE_SECURE=false

# Token opcional para scripts/curl (não é usado pelo formulário de login)
WEB_ADMIN_TOKEN=

# Chave Pix exibida na área do membro (opcional)
PIX_CHAVE=
